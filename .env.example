# Chép file này thành .env và điền giá trị máy bạn.
# .env không được commit.

# Base URL của API Spring Boot.
# Emulator Android KHÔNG dùng được localhost — 10.0.2.2 mới là địa chỉ
# trỏ về máy host từ trong emulator.
# Máy Android thật cắm dây thì dùng IP LAN của máy tính, ví dụ 192.168.1.x
# iOS simulator thì localhost dùng bình thường.
API_BASE_URL=http://10.0.2.2:8080
